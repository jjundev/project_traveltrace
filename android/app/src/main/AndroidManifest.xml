<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 네트워크 가용성 확인용 (오프라인 재생/타일 실패 안내, PRD §5 오프라인). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- PRD §4.1/§6: broad media access (blocks Play Store release; accepted for sideload). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- PRD §4.2: required for original-photo GPS EXIF via setRequireOriginal(). -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <application
        android:name=".TravelTraceApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TravelTrace">

        <!-- Maps Android SDK key (injected from local.properties via manifestPlaceholders). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
