<?xml version="1.0" encoding="utf-8"?>
<!--
  Pretendard — Toss Product Sans 대체 폰트 (OFL, orioncactus/pretendard v1.3.9 공식 static OTF).
  정적 다중 파일 패밀리: 각 <font>가 android:fontWeight/fontStyle를 선언하고,
  뷰/스타일은 android:fontFamily="@font/pretendard" + android:textFontWeight 로
  가장 가까운 정적 가중치를 선택한다 (API 26/28+, minSdk 33 충족).
  400/500/600/700만 번들. 800(ExtraBold) 등은 최근접 가중치로 폴백.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/pretendard_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:font="@font/pretendard_medium" />
    <font
        android:fontStyle="normal"
        android:fontWeight="600"
        android:font="@font/pretendard_semibold" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/pretendard_bold" />
</font-family>
